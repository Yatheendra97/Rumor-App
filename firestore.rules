rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(code) {
      return signedIn() && exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
    }
    match /rooms/{code} {
      // Codes are shareable invitations. Clients may get a known code but cannot list rooms.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['createdAt', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /members/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || member(code));
        allow list: if member(code);
        allow create: if signedIn() && request.auth.uid == uid
          && existsAfter(/databases/$(database)/documents/rooms/$(code))
          && request.resource.data.keys().hasOnly(['name', 'seed', 'joinedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 64
          && request.resource.data.seed is string && request.resource.data.seed.size() <= 128
          && request.resource.data.joinedAt == request.time;
        allow update, delete: if false;
      }
      match /messages/{messageId} {
        allow read: if member(code);
        allow create: if member(code)
          && request.resource.data.keys().hasOnly(['senderId', 'name', 'text', 'clientTime', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.name == get(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid)).data.name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.clientTime is timestamp
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
